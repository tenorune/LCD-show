#!/usr/bin/env python3
"""On-LCD touch menu (GTK).

A full-panel dark window with one large, full-width button per kiosk app, with
the button group vertically centered. Tapping a button switches the kiosk to that
app. Runs as the 'menu' kiosk app inside the fb1 X server, which has no window
manager -- so size and position are set explicitly, and the dark area above and
below the buttons is the window's own background (no separate backdrop to mismatch).

This is GTK rather than yad because some yad builds ignore CSS sizing and yad's
form has no vertical-centering option.
"""
import os
import subprocess

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, Gtk  # noqa: E402

CONF = os.environ.get("LCD_KIOSK_CONF", "/etc/lcd-kiosk/kiosk.conf")
FONT_PX = int(os.environ.get("LCD_MENU_FONT_PX", "44"))
WIDTH = int(os.environ.get("LCD_MENU_WIDTH", "480"))
HEIGHT = int(os.environ.get("LCD_MENU_HEIGHT", "320"))


def list_apps():
    """Return catalog app names from kiosk.conf, excluding 'menu' itself."""
    apps = []
    try:
        with open(CONF) as fh:
            for line in fh:
                line = line.strip()
                if line.startswith("KIOSK_APP_") and "=" in line:
                    name = line[len("KIOSK_APP_"):line.index("=")]
                    if name and name != "menu":
                        apps.append(name)
    except OSError:
        pass
    return apps


def on_clicked(_button, name):
    subprocess.Popen(["lcd-kiosk", "set", name])
    Gtk.main_quit()


def main():
    apps = list_apps()
    if not apps:
        return

    css = Gtk.CssProvider()
    css.load_from_data(
        ("window { background-color: #101418; }"
         "button { font-size: %dpx; margin: 8px 16px; }" % FONT_PX).encode()
    )
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    win = Gtk.Window()
    win.set_decorated(False)
    win.set_resizable(False)
    win.set_default_size(WIDTH, HEIGHT)
    win.connect("destroy", Gtk.main_quit)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    box.set_valign(Gtk.Align.CENTER)
    for name in apps:
        button = Gtk.Button(label=name)
        button.set_hexpand(True)
        button.connect("clicked", on_clicked, name)
        box.pack_start(button, False, True, 0)
    win.add(box)

    win.show_all()
    win.move(0, 0)
    win.resize(WIDTH, HEIGHT)
    Gtk.main()


if __name__ == "__main__":
    main()
