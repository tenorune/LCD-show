#!/usr/bin/env bash
# On-LCD touch menu. Renders each kiosk app as a large, centered, touch-friendly
# button filling the panel; tapping one sets it as the default and switches the
# LCD to it. Intended to run as the 'menu' kiosk app (inside the fb1 X server,
# which has no window manager -- hence the explicit geometry).
set -euo pipefail

LCD_KIOSK_LIB="${LCD_KIOSK_LIB:-/usr/local/lib/lcd-kiosk/lib.sh}"
LCD_KIOSK_CONF="${LCD_KIOSK_CONF:-/etc/lcd-kiosk/kiosk.conf}"
# Panel size; override via the environment if your panel differs.
LCD_MENU_GEOMETRY="${LCD_MENU_GEOMETRY:-480x320+0+0}"
# shellcheck source=/dev/null
. "$LCD_KIOSK_LIB"

# Build the choosable list (exclude the menu entry itself).
mapfile -t apps < <(kiosk_list_apps "$LCD_KIOSK_CONF" | grep -vx menu)
[ "${#apps[@]}" -gt 0 ] || exit 0

# Large, dark, touch-friendly styling for the small panel.
css="$(mktemp --suffix=.css)"
trap 'rm -f "$css"' EXIT
cat > "$css" <<'EOF'
window { background-color: #101418; }
label  { color: #cfd8e0; font-size: 18px; }
button { font-size: 44px; min-height: 150px; margin: 10px; }
EOF

# One big button per app; each button returns a distinct exit code.
args=()
declare -A code_app
code=10
for a in "${apps[@]}"; do
    args+=( --button="$a:$code" )
    code_app[$code]="$a"
    code=$((code + 1))
done

yad --geometry="$LCD_MENU_GEOMETRY" --css="$css" \
    --title="LCD menu" --text="Show on LCD" --text-align=center \
    --buttons-layout=spread "${args[@]}" 2>/dev/null
choice="${code_app[$?]-}"
[ -n "$choice" ] || exit 0

# Persist + switch. lcd-kiosk restarts the service, replacing this menu with the
# chosen app.
lcd-kiosk set "$choice"
