#!/usr/bin/env python3
"""Watch the touchscreen and, on a long-press held in a chosen corner, invoke
`lcd-kiosk menu` to summon the on-LCD menu. Best-effort convenience; the shell
command `lcd-kiosk menu` always works as a fallback.

The watcher reads events in parallel with the kiosk X server (which is configured
with GrabDevice off), and only observes -- it never consumes taps.

Which physical corner maps to which raw ABS_X/ABS_Y end depends on the panel's
rotation and axis inversion, so the corner is configurable. Defaults target the
screen's top-left on a tft35a:rotate=90 panel, where top = low raw ABS_X and
left = high raw ABS_Y:
    LCD_TOUCH_X_LOW=1   corner is at the low-ABS_X end   (panel top)
    LCD_TOUCH_Y_LOW=0   corner is at the high-ABS_Y end  (panel left)
Set either to the opposite value (0/1) to pick a different corner.
"""
import os
import subprocess
import time

from evdev import InputDevice, ecodes, list_devices

DEVICE_NAME = os.environ.get("LCD_TOUCH_NAME", "ADS7846 Touchscreen")
CORNER_FRAC = float(os.environ.get("LCD_TOUCH_CORNER_FRAC", "0.25"))
HOLD_SECONDS = float(os.environ.get("LCD_TOUCH_HOLD_SECONDS", "1.5"))
X_AT_LOW = os.environ.get("LCD_TOUCH_X_LOW", "1") != "0"
Y_AT_LOW = os.environ.get("LCD_TOUCH_Y_LOW", "0") != "0"


def find_device():
    for path in list_devices():
        dev = InputDevice(path)
        if DEVICE_NAME in dev.name:
            return dev
        dev.close()
    return None


def axis_range(dev, code):
    for c, absinfo in dev.capabilities().get(ecodes.EV_ABS, []):
        if c == code:
            return absinfo.min, absinfo.max
    return 0, 4095


def main():
    dev = None
    while dev is None:
        dev = find_device()
        if dev is None:
            time.sleep(2)

    xmin, xmax = axis_range(dev, ecodes.ABS_X)
    ymin, ymax = axis_range(dev, ecodes.ABS_Y)
    x_lo = xmin + (xmax - xmin) * CORNER_FRAC
    x_hi = xmax - (xmax - xmin) * CORNER_FRAC
    y_lo = ymin + (ymax - ymin) * CORNER_FRAC
    y_hi = ymax - (ymax - ymin) * CORNER_FRAC

    x = y = None
    touching = False
    press_start = 0.0
    fired = False

    for ev in dev.read_loop():
        if ev.type == ecodes.EV_ABS:
            if ev.code == ecodes.ABS_X:
                x = ev.value
            elif ev.code == ecodes.ABS_Y:
                y = ev.value
        elif ev.type == ecodes.EV_KEY and ev.code == ecodes.BTN_TOUCH:
            touching = ev.value == 1
            if touching:
                press_start = time.time()
                fired = False
            continue

        if touching and not fired and x is not None and y is not None:
            in_x = x <= x_lo if X_AT_LOW else x >= x_hi
            in_y = y <= y_lo if Y_AT_LOW else y >= y_hi
            if in_x and in_y and (time.time() - press_start) >= HOLD_SECONDS:
                fired = True
                subprocess.Popen(["lcd-kiosk", "menu"])


if __name__ == "__main__":
    main()
